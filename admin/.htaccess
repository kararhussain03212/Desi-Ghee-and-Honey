<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/

  # If file or folder exists, serve it
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise redirect everything to index.html
  RewriteRule . index.html [L]
</IfModule>
